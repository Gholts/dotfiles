#!/usr/bin/env bash
set -u

service="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$service" in
  google)
    SERVICE_NAME="Google Lens"
    SEARCH_URL_PREFIX="https://lens.google.com/uploadbyurl?url="
    UPLOAD_API_URL="https://www.google.com/searchbyimage/upload"
    MAX_IMAGE_SIDE="${google_max_image_side:-1280}"
    JPEG_QUALITY="${google_jpeg_quality:-60}"
    ;;
  yandex)
    SERVICE_NAME="Yandex Images"
    SEARCH_URL_PREFIX="https://yandex.com/images/search?rpt=imageview&url="
    UPLOAD_API_URL='https://yandex.com/images/search?rpt=imageview&format=json&request=%7B%22blocks%22%3A%5B%7B%22block%22%3A%22b-page_type_search-by-image__link%22%7D%5D%7D'
    MAX_IMAGE_SIDE="${yandex_max_image_side:-900}"
    JPEG_QUALITY="${yandex_jpeg_quality:-45}"
    ;;
  *)
    echo "Unknown image search service."
    exit 1
    ;;
esac

first_input() {
  if [ "$#" -gt 0 ] && [ -n "${1:-}" ]; then
    printf '%s' "$1"
  fi
}

urlencode() {
  /usr/bin/python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

decode_file_url() {
  /usr/bin/python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(urllib.parse.urlparse(sys.argv[1]).path))' "$1"
}

expand_path() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${1#~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

is_url() {
  case "$1" in
    http://*|https://*) return 0 ;;
    *) return 1 ;;
  esac
}

is_image_file() {
  [ -f "$1" ] || return 1
  local mime
  mime="$(/usr/bin/file -b --mime-type "$1" 2>/dev/null || true)"
  case "$mime" in
    image/*) return 0 ;;
    *) return 1 ;;
  esac
}

open_target() {
  if [ "${IMAGE_SEARCH_DRY_RUN:-0}" = "1" ]; then
    printf 'OPEN:%s\n' "$1"
    return 0
  fi
  /usr/bin/open "$1"
}

open_google_target() {
  if [ "${IMAGE_SEARCH_DRY_RUN:-0}" = "1" ]; then
    printf 'OPEN:%s\n' "$1"
    return 0
  fi
  /usr/bin/open "$1"
}

cache_root() {
  printf '%s/image-search/%s' "${alfred_workflow_cache:-${TMPDIR:-/tmp}}" "$service"
}

capture_screenshot() {
  local root capture_path
  root="$(cache_root)"
  capture_path="$root/selection-$(date +%Y%m%d-%H%M%S).jpg"

  mkdir -p "$root" >/dev/null 2>&1 || return 1
  /usr/sbin/screencapture -i -x -t jpg "$capture_path" || return 1

  [ -s "$capture_path" ] || return 1
  printf '%s' "$capture_path"
}

prepare_upload_image() {
  local image_path="$1"
  local max_side="${2:-$MAX_IMAGE_SIDE}"
  local quality="${3:-$JPEG_QUALITY}"
  local label="${4:-upload}"
  local root upload_path
  root="$(cache_root)"
  upload_path="$root/$label-$(date +%Y%m%d-%H%M%S).jpg"

  mkdir -p "$root" >/dev/null 2>&1 || {
    printf '%s' "$image_path"
    return 0
  }

  if command -v /usr/bin/sips >/dev/null 2>&1; then
    /usr/bin/sips -Z "$max_side" -s format jpeg -s formatOptions "$quality" \
      "$image_path" --out "$upload_path" >/dev/null 2>&1 &&
      [ -s "$upload_path" ] &&
      printf '%s' "$upload_path" &&
      return 0
  fi

  printf '%s' "$image_path"
}

upload_yandex_image() {
  local image_path="$1"
  local attempts="${2:-2}"
  local attempt=1
  local root response_path http_status curl_status parse_status
  command -v curl >/dev/null 2>&1 || return 1

  root="$(cache_root)"
  mkdir -p "$root" >/dev/null 2>&1 || return 1

  while [ "$attempt" -le "$attempts" ]; do
    response_path="$(mktemp "$root/yandex-response.XXXXXX")" || return 1
    http_status="$(curl -sS --compressed --connect-timeout 8 --max-time 25 \
      -A "Mozilla/5.0 (Macintosh; Intel Mac OS X) AppleWebKit/605.1.15 Safari/605.1.15" \
      -H "Accept: application/json" \
      -H "Expect:" \
      -H "Referer: https://yandex.com/images/" \
      -F "upfile=@${image_path}" \
      -o "$response_path" \
      -w "%{http_code}" \
      "$UPLOAD_API_URL")"
    curl_status=$?

    if [ "$curl_status" -eq 0 ] && [ "${http_status#2}" != "$http_status" ]; then
      /usr/bin/python3 - "$response_path" <<'PY'
import json
import sys
from urllib.parse import quote

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        payload = json.load(handle)
    params = payload["blocks"][0]["params"]
except Exception:
    sys.exit(1)

cbir_id = params.get("cbirId")
if cbir_id:
    print("https://yandex.com/images/search?rpt=imageview&cbir_id=" + quote(cbir_id, safe="/"))
    sys.exit(0)

image_url = params.get("originalImageUrl")
if image_url:
    print("https://yandex.com/images/search?rpt=imageview&url=" + quote(image_url, safe=""))
    sys.exit(0)

sys.exit(1)
PY
      parse_status=$?
      rm -f "$response_path"
      if [ "$parse_status" -eq 0 ]; then
        return 0
      fi
      echo "Yandex upload attempt $attempt returned no result URL." >&2
    else
      rm -f "$response_path"
      if [ "$curl_status" -ne 0 ]; then
        echo "Yandex upload attempt $attempt failed (curl $curl_status)." >&2
      else
        echo "Yandex upload attempt $attempt failed (HTTP ${http_status:-unknown})." >&2
      fi
    fi

    attempt=$((attempt + 1))
    if [ "$attempt" -le "$attempts" ]; then
      sleep 1
    fi
  done

  return 1
}

open_google_upload() {
  local image_path="$1"

  if [ "${IMAGE_SEARCH_DRY_RUN:-0}" = "1" ]; then
    printf 'UPLOAD:%s\n' "$image_path"
    return 0
  fi

  /usr/bin/python3 - "$image_path" "$UPLOAD_API_URL" <<'PY'
import base64
from http.server import BaseHTTPRequestHandler, HTTPServer
import html
import json
import mimetypes
import os
import secrets
import subprocess
import sys
import time

image_path, upload_url = sys.argv[1:]
mime = mimetypes.guess_type(image_path)[0] or "image/jpeg"
name = os.path.basename(image_path) or "search.jpg"
with open(image_path, "rb") as handle:
    data = base64.b64encode(handle.read()).decode("ascii")

document = f"""<!doctype html>
<meta charset="utf-8">
<title>Google Lens Upload</title>
<p id="status">Uploading to Google Lens…</p>
<form id="upload" method="post" enctype="multipart/form-data" action="{html.escape(upload_url)}">
  <input id="encoded_image" type="file" name="encoded_image" hidden>
  <input type="hidden" name="image_content" value="">
  <input type="hidden" name="filename" value="{html.escape(name)}">
</form>
<script>
try {{
  const binary = atob({json.dumps(data)});
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  const file = new File([bytes], {json.dumps(name)}, {{type: {json.dumps(mime)}}});
  const transfer = new DataTransfer();
  transfer.items.add(file);
  document.getElementById("encoded_image").files = transfer.files;
  document.getElementById("upload").submit();
}} catch (error) {{
  document.getElementById("status").textContent = "Google Lens upload failed: " + error;
}}
</script>
""".encode()

secret_path = "/" + secrets.token_urlsafe(24)

class Handler(BaseHTTPRequestHandler):
    served = False

    def do_GET(self):
        if self.path != secret_path:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(document)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Security-Policy", "sandbox allow-forms allow-scripts")
        self.end_headers()
        self.wfile.write(document)
        Handler.served = True

    def log_message(self, *_):
        pass

server = HTTPServer(("127.0.0.1", 0), Handler)
server.timeout = 1
target = f"http://127.0.0.1:{server.server_port}{secret_path}"
subprocess.run(["/usr/bin/open", target], check=True)

deadline = time.monotonic() + 20
while not Handler.served and time.monotonic() < deadline:
    server.handle_request()
server.server_close()
if not Handler.served:
    sys.exit("Browser did not load Google Lens upload page.")
PY
}

had_argument=0
if [ "$#" -gt 0 ] && [ -n "${1:-}" ]; then
  had_argument=1
fi

query="$(first_input "$@")"
query="${query//$'\r'/}"
query="${query%%$'\n'*}"

if [ "$had_argument" -eq 0 ]; then
  query="$(capture_screenshot)"
  if [ -z "$query" ]; then
    echo "Screenshot cancelled."
    exit 1
  fi
fi

if is_url "$query"; then
  if [ "$service" = "google" ]; then
    encoded="$(urlencode "$query")"
    open_google_target "${SEARCH_URL_PREFIX}${encoded}"
    echo "Opened $SERVICE_NAME URL search."
    exit 0
  else
    encoded="$(urlencode "$query")"
    open_target "${SEARCH_URL_PREFIX}${encoded}"
    echo "Opened $SERVICE_NAME reverse search."
    exit 0
  fi
fi

if [ "${query#file://}" != "$query" ]; then
  query="$(decode_file_url "$query")"
fi

path="$(expand_path "$query")"
if ! is_image_file "$path"; then
  echo "Need image URL or local image path."
  exit 1
fi

upload_path="$(prepare_upload_image "$path")"
case "$service" in
  google)
    if open_google_upload "$upload_path"; then
      echo "Opened $SERVICE_NAME browser upload."
      exit 0
    fi
    echo "Google Lens upload failed."
    ;;
  yandex)
    result_url="$(upload_yandex_image "$upload_path" 2 || true)"
    if [ -z "$result_url" ]; then
      echo "Yandex retrying with a smaller image." >&2
      fallback_path="$(prepare_upload_image "$path" \
        "${yandex_fallback_max_image_side:-640}" \
        "${yandex_fallback_jpeg_quality:-35}" \
        "fallback")"
      result_url="$(upload_yandex_image "$fallback_path" 1 || true)"
    fi
    if [ -n "$result_url" ]; then
      open_target "$result_url"
      echo "Opened $SERVICE_NAME results."
      exit 0
    fi
    echo "Yandex upload failed."
    ;;
esac

exit 1
